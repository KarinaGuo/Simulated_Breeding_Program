# Load the original data to get the dimensions and column names
original_df <- read.csv("uploaded_F0_genotypes_LowDiv.csv")
setwd("~/Uni/Doctorate/Breeding_project")
# Load the original data to get the dimensions and column names
original_df <- read.csv("uploaded_F0_genotypes_LowDiv.csv")
# Get number of individuals and SNPs
num_individuals <- nrow(original_df)
# Exclude the first column ('indiv_ID') to get just the SNP names
snp_names <- colnames(original_df)[-1]
# Load the original data to get the dimensions and column names
original_df <- read.csv("data/uploaded_F0_genotypes_LowDiv.csv")
# Load the original data to get the dimensions and column names
original_df <- read.csv("data/_uploaded_F0_genotypes_LowDiv.csv")
# Get number of individuals and SNPs
num_individuals <- nrow(original_df)
# Exclude the first column ('indiv_ID') to get just the SNP names
snp_names <- colnames(original_df)[-1]
num_snps <- length(snp_names)
# Parameters for low genetic diversity
# We want allele frequencies to be close to 0 or 1 for most loci
major_allele_frequency_mean <- 0.95
major_allele_frequency_sd <- 0.05
# Initialize an empty matrix to hold the genotypes
genotypes <- matrix(0, nrow = num_individuals, ncol = num_snps)
# Generate synthetic genotypes for low diversity
set.seed(42) # Optional: set a seed for reproducibility
for (i in 1:num_snps) {
# Sample a major allele frequency for each SNP
maf <- rnorm(1, mean = major_allele_frequency_mean, sd = major_allele_frequency_sd)
# Clip the MAF to be between 0.5 and 1.0 (similar to np.clip)
p <- max(0.5, min(1.0, maf))
q <- 1 - p
# Calculate probabilities for genotypes 0, 1, 2 assuming Hardy-Weinberg equilibrium
p_0 <- q^2
p_1 <- 2 * p * q
p_2 <- p^2
# Generate genotypes based on the probabilities
genotypes[, i] <- sample(c(0, 1, 2), size = num_individuals, replace = TRUE, prob = c(p_0, p_1, p_2))
}
# Create a DataFrame
new_df <- data.frame(indiv_ID = 1:num_individuals)
genotypes_df <- as.data.frame(genotypes)
colnames(genotypes_df) <- snp_names
# Combine the indiv_ID column with the genotypes
final_df <- cbind(new_df, genotypes_df)
# Save the new DataFrame to a CSV file
write.csv(final_df, "synthetic_F0_genotypes_LowDiv.csv", row.names = FALSE)
cat("Low diversity synthetic dataset created and saved to 'synthetic_F0_genotypes_LowDiv.csv'\n")

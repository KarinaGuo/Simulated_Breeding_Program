) %>%
mutate(
Metric = recode(Metric,
mean_GEBV = "Mean GEBV",
allelic_capture = "Allelic Capture")
)
# Create the plot
p <- ggplot(plot_data, aes(x = generation, y = Value, color = Scenario, group = Scenario)) +
geom_point(size = 3) +
geom_line(alpha = 0.7, size = 1) +
facet_wrap(~ Metric, scales = "free_y") +
theme_minimal(base_size = 14) +
labs(
title = "Breeding Project: Scenario Performance over Generations",
subtitle = "Tracking Mean GEBV and Allelic Capture (F0 to F2)",
x = "Generation",
y = "Score",
color = "Scenario"
) +
theme(
legend.position = "right",
panel.background = element_rect(fill = "white", color = NA),
plot.background = element_rect(fill = "white", color = NA)
)

spatial_thin_maxmin <- function(lon, lat, k = 6) {
n <- length(lon)
# If population is already smaller than or equal to k, keep all
if (n <= k) return(1:n)
# Calculate full distance matrix (in meters) for this population
pts <- cbind(lon, lat)
dist_mat <- distm(pts, fun = distGeo)
# Initialize empty vector to store the row indices of selected samples
selected <- numeric(k)
# 1st point: Select randomly
selected[1] <- sample(1:n, 1)
# Iterate to find points 2 through k
for (i in 2:k) {
if (i == 2) {
# For the 2nd point, we just look at distances to the 1st point
min_dists <- dist_mat[, selected[1]]
} else {
# For points 3+, find distance to closest already-selected point
# apply(..., 1, min) gets the row-wise minimum
min_dists <- apply(dist_mat[, selected[1:(i-1)]], 1, min)
}
# Set distances of already selected points to -1 so they aren't picked again
min_dists[selected[1:(i-1)]] <- -1
# Select the point that has the MAXIMUM of these minimum distances
selected[i] <- which.max(min_dists)
}
return(selected)
}
# 2. Apply the custom thinning function to the large populations
set.seed(42) # Ensure the first randomly picked point is reproducible
large_pops <- df_sampled %>%
filter(Selection_Strategy == "Target_Species_Pop") %>%
group_by(Species, Species_Pop_ID) %>%
# slice() applies the function to each group, returning exactly 6 rows per group
# that maximize geographic spread
dplyr::slice(spatial_thin_maxmin(Location.Long, Location.Lat, k = 6)) %>%
ungroup() %>%
mutate(Status = "Selected - Max-Min Spatial Thinning (n=6)")
# Step B: Process the small populations (< 6) at the Genus level
# We pool them by genus, then filter out populations that are too close to each other
drop_nearby_populations <- function(df_group, min_dist_km = 20) {
# If the pool is empty or only has 1 population, no filtering needed
if (nrow(df_group) == 0 || length(unique(df_group$Species_Pop_ID)) <= 1) {
return(df_group)
}
# Calculate geographic centroid and size for each population
pop_summary <- df_group %>%
group_by(Species_Pop_ID) %>%
summarise(
centroid_lon = mean(Location.Long),
centroid_lat = mean(Location.Lat),
pop_size = n(),
.groups = "drop"
) %>%
# Sort descending by size to prioritize keeping larger small-populations
arrange(desc(pop_size))
kept_pops <- c()
kept_coords <- matrix(ncol = 2, nrow = 0)
# Greedy selection loop
for (i in 1:nrow(pop_summary)) {
current_pop <- pop_summary$Species_Pop_ID[i]
current_coord <- c(pop_summary$centroid_lon[i], pop_summary$centroid_lat[i])
if (length(kept_pops) == 0) {
# Always keep the first (largest) population
kept_pops <- c(kept_pops, current_pop)
kept_coords <- rbind(kept_coords, current_coord)
} else {
# Calculate distance to all ALREADY KEPT populations (distm returns meters)
dists <- distm(matrix(current_coord, ncol = 2), kept_coords, fun = distGeo)
# If the minimum distance to any kept population is greater than the threshold, keep it
if (min(dists) > (min_dist_km * 1000)) {
kept_pops <- c(kept_pops, current_pop)
kept_coords <- rbind(kept_coords, current_coord)
}
}
}
# Return the original dataframe, filtered to only include the kept populations
return(df_group %>% filter(Species_Pop_ID %in% kept_pops))
}
# 2. Apply the distance filter to the Genus pool
# We use group_modify to pass each Genus chunk into our custom function
small_pops <- df_sampled %>%
filter(Selection_Strategy == "Target_Genus_Pool") %>%
group_by(Genus) %>%
group_modify(~ drop_nearby_populations(.x, min_dist_km = 20)) %>%
ungroup() %>%
mutate(Status = paste("Selected - Genus Pool (Filtered 20km)"))
# 3. Combine with Step A as normal
final_selection <- bind_rows(large_pops, small_pops) %>%
group_by(Genus) %>%
mutate(
Plate_Number = ceiling(row_number() / 94),
Plate_Set_ID = paste0(Genus, "_Plate_", Plate_Number)
) %>%
ungroup()
# 4. Group into sets of 94 per Genus
final_selection <- final_selection %>%
group_by(Genus) %>%
mutate(
# Assign a plate number based on rows (94 per plate)
Plate_Number = ceiling(row_number() / 94),
Plate_Set_ID = paste0(Genus, "_Plate_", Plate_Number)
) %>%
ungroup()
final_selection <- final_selection %>%
mutate(
# Replace spaces in species name with underscores and append the Pop ID
Global_Pop_ID = paste0(str_replace_all(Species, " ", "_"), "_Pop_", Species_Pop_ID)
) %>%
# Relocate it to the front of the dataframe for easier reading
relocate(Global_Pop_ID, .after = Species)
library(dplyr)
# 1. Calculate plate capacity per Genus
genus_capacity <- final_selection %>%
group_by(Genus) %>%
summarise(
Total_Samples = n(),
Full_Plates = floor(Total_Samples / 94),
Remainder = Total_Samples %% 94,
.groups = "drop"
) %>%
mutate(
# Determine how many plates to keep
# If a Genus has < 40 samples total, it gets 0 plates (dropped entirely)
# If the remainder is < 40, we drop that partial plate
Target_Plates = case_when(
Total_Samples < 40 ~ 0,
Remainder < 40 ~ Full_Plates,
TRUE ~ Full_Plates + 1
),
# Calculate the new hard limit of samples for this Genus
Target_Capacity = Target_Plates * 94
)
# 2. Rank populations and pack them into the available capacity
optimized_selection <- final_selection %>%
# Count how many samples each population contributes to the final selection
group_by(Genus, Global_Pop_ID, Selection_Strategy) %>%
mutate(Pop_Selected_n = n()) %>%
ungroup() %>%
# Get unique populations with their sizes to figure out which to keep
dplyr::select(Genus, Global_Pop_ID, Selection_Strategy, Pop_Selected_n) %>%
distinct() %>%
left_join(genus_capacity %>% dplyr::select(Genus, Target_Capacity), by = "Genus") %>%
# Rank populations to prioritize sufficient sampling
group_by(Genus) %>%
arrange(
Genus,
# Priority 1: Keep the large n=6 target populations first
desc(Selection_Strategy == "Target_Species_Pop"),
# Priority 2: Keep larger populations to maximize well-sampled groups
desc(Pop_Selected_n)
) %>%
# Calculate cumulative sum of samples as we add populations
mutate(
Cumulative_Samples = cumsum(Pop_Selected_n),
# Only keep the population if adding it doesn't exceed plate capacity
Keep_Pop = Cumulative_Samples <= Target_Capacity
) %>%
ungroup()
# 3. Filter the final dataset to only include the kept populations
final_selection_optimized <- final_selection %>%
inner_join(
optimized_selection %>% filter(Keep_Pop) %>% dplyr::select(Global_Pop_ID),
by = "Global_Pop_ID"
) %>%
# 4. Re-assign plate numbers based on the new, optimized rows
group_by(Genus) %>%
mutate(
Plate_Number = ceiling(row_number() / 94),
Plate_Set_ID = paste0(Genus, "_Plate_", Plate_Number)
) %>%
ungroup()
# View summary of the optimization
table(final_selection_optimized$Plate_Set_ID)
# Load required libraries
df_plot <- df_sampled %>%
mutate(
Global_Pop_ID = paste0(str_replace_all(Species, " ", "_"), "_Pop_", Species_Pop_ID),
# Check if the sample's barcode exists in our final selected dataset
Is_Selected = Tissue.sample.barcode %in% final_selection_optimized$Tissue.sample.barcode
)
# Convert to spatial object
sf_plot <- st_as_sf(df_plot, coords = c("Location.Long", "Location.Lat"), crs = 4326)
# 2. Generate Convex Hulls for each Global_Pop_ID
# We group the spatial points by population, combine their geometries, and draw a hull.
# (Note: For populations with only 1 or 2 points, sf will gracefully draw a point or line)
hulls <- sf_plot %>%
group_by(Global_Pop_ID, Species, Genus, Selection_Strategy) %>%
summarise(geometry = st_combine(geometry), .groups = "drop") %>%
st_convex_hull()
# 3. Calculate bounding box for the map limits
bbox <- st_bbox(sf_plot)
lon_buffer <- (bbox["xmax"] - bbox["xmin"]) * 0.1
lat_buffer <- (bbox["ymax"] - bbox["ymin"]) * 0.1
# 4. Generate the Plot
map_plot <- ggplot() +
# Layer 1: Hulls around each population (colored by species, dashed outline)
geom_sf(data = hulls,
aes(color = Species),
shape = 17,
linetype = "dashed",
linewidth = 0.5,
alpha = 0.5) +
# Layer 2: Unselected samples (grey50, smaller size, pushed to background)
geom_sf(data = filter(sf_plot, !Is_Selected),
aes(color = Species),
shape = 16,
alpha = 0.5) +
# Layer 3: Selected samples (colored by Species, larger size)
geom_sf(data = filter(sf_plot, Is_Selected),
aes(color = Species),
alpha = 1) +
# Set map limits based on data bounding box
coord_sf(xlim = c(bbox["xmin"] - lon_buffer, bbox["xmax"] + lon_buffer),
ylim = c(bbox["ymin"] - lat_buffer, bbox["ymax"] + lat_buffer),
expand = FALSE) +
# Facet grid: Strategies as rows, Genus as columns
facet_grid(~Genus*Is_Selected) +
# Styling
scale_color_viridis_d(name = "Species", option = "turbo") +
theme_bw() +
labs(
title = "Spatial Distribution of Genotyping Selections",
x = "Longitude",
y = "Latitude"
)
